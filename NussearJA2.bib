@article{lawrenceDeterminingHeatIsland2020,
	title = {Determining heat island response to varying land cover changes between 2004 and 2017 within the city of {Reno}, {Nevada}},
	volume = {59},
	issn = {0575-5700},
	url = {http://dspace.calstate.edu/handle/10211.3/216930},
	abstract = {The objective of this research was to investigate the role of land cover changes through time in influencing spatial variability of the surface urban heat island of the metropolitan area of Reno-Sparks, Nevada. Thermal imagery from Landsat 7 ETM+ sensor was gathered for a period between 2004 and 2017. Using parcel data, the time series of Landsat data was sampled for areas that had undergone development during that time. A set of generalized linear models was conducted to determine expected temperature change with land cover class. It was found that recently developed regions within Reno-Sparks are 0.6oC warmer on average than the undeveloped desert grasses and sage. When wetlands/irrigated greenery were converted, it resulted in an increase of over 2oC. This research has shown that the Reno-Sparks surface urban heat island has undergone local, but measurable, growth in the past fourteen years.},
	urldate = {2021-01-23},
	journal = {The California Geographer},
	author = {Lawrence, B. W.* and Nussear, K. E. and Heaton, J. S.},
	year = {2020},
	keywords = {journal},
	file = {Full Text PDF:/home/knussear/Zotero/storage/IKU8JTXV/Lawrence et al. - 2020 - Determining heat island response to varying land c.pdf:application/pdf;Snapshot:/home/knussear/Zotero/storage/V2B7YNQG/216930.html:text/html},
}

