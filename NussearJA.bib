@article{snyderEffectsWildfireThermal2025,
  title = {Effects of {{Wildfire}} on the {{Thermal Ecology}} of {{Mojave Desert Tortoises}} ({{Gopherus}} Agassizii)},
  author = {Snyder, S. J.* and Nussear, K. E. and DeFalco, L. A. and Tracy, C. R.},
  date = {2025},
  journaltitle = {Herpetological Monographs},
  volume = {Accepted},
  issn = {0306-4565},
  doi = {10.1016/j.jtherbio.2019.102414},
  abstract = {Wildfires are progressively consuming more low and middle elevation shrublands and woodlands in the Mojave Desert, raising concern about the effects of wildfire on Mojave Desert Tortoises (Gopherus agassizii) and their habitat. The aim of this study was to compare the thermal quality of unburned habitat with habitat that burned once in 2005 to assess the mechanistic impact of wildfire on Desert Tortoise thermal ecology. Operative temperature models were used to calculate daily indices of thermal habitat quality on the ground surface, to determine the number of available hours during which tortoises could achieve their preferred body temperature, and to evaluate the thermal suitability of microhabitats in burned and unburned habitat in years following wildfire. We found that the thermal quality index was similar between burned and unburned habitat, but unburned habitat was more thermally heterogeneous and facilitated longer activity periods for tortoises. Even during the most thermally inhospitable times of the activity season, tortoises could be active on most days for at least three hours in both habitats, which likely exceeds the time needed by Desert Tortoises to acquire food resources while foraging on the ground surface, since tortoises normally spend the majority of their time in burrows. Shrub microhabitats provided tortoises with more potential time to be active within their preferred body temperature range than did microhabitats with no shade. Below-ground thermal quality in burned and unburned habitats, assessed by recording temperatures in burrows with different types of shrub cover, were similar regardless of whether live or dead shrubs were present near the burrow mouth. We found no difference in the percentage of time tortoises in burned and unburned habitat were able to achieve body temperatures within their preferred range, but minimum body temperatures were lower in burned habitat and the range of achievable body temperatures was greater. Given that tortoises are imprecise thermoregulators, the small magnitude difference observed in minimum body temperature and body temperature range is likely not of great physiological consequence. Results from this study suggest that few additional restoration efforts may be needed for tortoises to thermally exploit once-burned habitats in some areas for several years following wildfire, but changes may occur over longer time periods and differences may exist among sites or at sites that burn multiple times.},
  keywords = {Absorptance,journal,Light transmittance,Operative temperature,Plant canopy,Reptile}
}

@article{snyderModelingOperativeTemperature2019,
  title = {Modeling Operative Temperature in Desert Tortoises and Other Reptiles: {{Effects}} Imposed by Habitats That Filter Incident Radiation},
  shorttitle = {Modeling Operative Temperature in Desert Tortoises and Other Reptiles},
  author = {Snyder, S. J.* and Tracy, C. R. and Nussear, K. E.},
  date = {2019},
  journaltitle = {Journal of Thermal Biology},
  shortjournal = {Journal of Thermal Biology},
  volume = {85},
  pages = {102414},
  issn = {0306-4565},
  doi = {10.1016/j.jtherbio.2019.102414},
  url = {http://www.sciencedirect.com/science/article/pii/S0306456519303900},
  urldate = {2019-10-29},
  abstract = {We challenged the common practice of using a single mean absorptance based on unfiltered skylight spectra to model operative temperature for reptiles in filtered light habitats by examining the effects of plant canopies on light transmittance. To assess differences in light filtration over a range of microhabitats, spectra were recorded under canopies of desert plants, tropical plants, and under unfiltered skylight. Spectra were then integrated with absorptivity curves of desert reptiles to determine if differences in light quality among microhabitat types changed integrated mean absorptance. Finally, we used the desert tortoise (Gopherus agassizii) as a case study to investigate the effects of filtered microhabitats on paint choice for physical operative temperature models and determined the magnitude of error that could result from discrepancies between paint and animal absorptance. We found that light energy was partitioned similarly among microhabitats with like canopy types and that most variation was explained by differences in transmittance between the visible and near infrared wavelengths. Mean absorptance for reptiles was similar among microhabitats with the greatest differences observed between animals in unfiltered skylight and under tropical canopies. In most microhabitats paint and tortoise absorptances differed, but operative temperatures were nearly identical within microhabitats no matter the absorptance used in the model. The findings of this study support the use of a single mean absorptance in modeling operative temperature for reptiles in a variety of habitats.},
  keywords = {Absorptance,journal,Light transmittance,Operative temperature,Plant canopy,Reptile},
  file = {/home/knussear/Zotero/storage/2LZEWUTM/Snyder et al. - 2019 - Modeling operative temperature in desert tortoises.pdf;/home/knussear/Zotero/storage/ZKMY24L7/S0306456519303900.html}
}

